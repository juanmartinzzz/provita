{
  "name": "provita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:remote": "wrangler d1 migrations apply provita-db --remote",
    "db:studio": "wrangler d1 execute provita-db --remote --command \"SELECT name FROM sqlite_master WHERE type='table';\"",
    "repos:update": "for d in repos/*/; do [ -d \"$d/.git\" ] && git -C \"$d\" pull --ff-only; done"
  },
  "dependencies": {
    "@fontsource/bitcount-single": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "better-auth": "^1.6.25",
    "framer-motion": "^12.43.0",
    "hono": "^4.12.33",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.118.0"
  }
}
