# Cloudflare credentials for Wrangler (deploy / whoami / etc.)
# Docs: https://developers.cloudflare.com/workers/wrangler/system-environment-variables/
#
# Create a token: https://dash.cloudflare.com/profile/api-tokens
# Recommended: "Edit Cloudflare Workers" template (or custom with Workers Scripts:Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Used by local Vite (`npm run dev`). Leave unset in production builds
# so the deployed SPA uses same-origin /api.
# Example: https://provita.<your-subdomain>.workers.dev
VITE_API_BASE_URL=

# Better Auth (Worker). Secret must be ≥32 chars.
# Generate: openssl rand -base64 32
# Production: also `npx wrangler secret put BETTER_AUTH_SECRET`
BETTER_AUTH_URL=https://provita.<your-subdomain>.workers.dev
BETTER_AUTH_SECRET=
